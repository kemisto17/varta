{
  "expo": {
    "name": "Varta",
    "slug": "campus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/varta-icon.png",
    "scheme": "campus",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/varta-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/varta-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/varta-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/varta-icon.png",
          "imageWidth": 112
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vārtā to select photos for posts, event covers, and student verification.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
