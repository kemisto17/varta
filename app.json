{
  "expo": {
    "name": "Varta",
    "slug": "campus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/varta-icon-monogram.png",
    "scheme": "campus",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F7F4",
    "ios": {
      "icon": "./assets/images/varta-icon-monogram.png",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F4",
        "foregroundImage": "./assets/images/varta-adaptive-monogram.png",
        "monochromeImage": "./assets/images/varta-adaptive-monogram.png"
      },
      "backgroundColor": "#F8F7F4",
      "userInterfaceStyle": "automatic",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/varta-icon-monogram.png",
      "backgroundColor": "#F8F7F4"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7F4",
          "image": "./assets/images/varta-wordmark-light.png",
          "imageWidth": 190,
          "dark": {
            "backgroundColor": "#111110",
            "image": "./assets/images/varta-wordmark-dark.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Varta to select photos for posts, event covers, and student verification.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-sqlite",
      "expo-system-ui",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
