{
  "expo": {
    "name": "Varta",
    "slug": "varta",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/varta-icon-monogram.png",
    "scheme": "varta",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F7F4",
    "ios": {
      "icon": "./assets/images/varta-icon-monogram.png",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.kemisto17.varta",
      "googleServicesFile": "./google-services.json",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F4",
        "foregroundImage": "./assets/images/varta-adaptive-monogram.png",
        "monochromeImage": "./assets/images/varta-adaptive-monogram.png"
      },
      "backgroundColor": "#F8F7F4",
      "userInterfaceStyle": "automatic",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kemisto17.github.io",
              "pathPrefix": "/varta/open"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/varta-icon-monogram.png",
      "backgroundColor": "#F8F7F4"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7F4",
          "image": "./assets/images/varta-wordmark-light.png",
          "imageWidth": 190,
          "dark": {
            "backgroundColor": "#111110",
            "image": "./assets/images/varta-wordmark-dark.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Varta to select photos for posts, Lost & Found, event covers, and student verification.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#111110",
          "defaultChannel": "default"
        }
      ],
      "expo-sqlite",
      "expo-system-ui",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b4c59d1-224f-4997-a687-37951c6ce77e"
      }
    },
    "owner": "ramya17"
  }
}
